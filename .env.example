# Friendly Assistant Agent configuration
# Tests force deterministic mode from tests/conftest.py.
# For the Streamlit demo, enable Ollama below.

FRIENDLY_ASSISTANT_LLM_PROVIDER=ollama
FRIENDLY_ASSISTANT_DISABLE_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional LangSmith tracing for future observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

PYTHONPATH=.
